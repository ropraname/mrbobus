diff --git a/Firmware/MotorControl/hall_velocity_compensator.hpp b/Firmware/MotorControl/hall_velocity_compensator.hpp
new file mode 100644
index 0000000..8bd12c9
--- /dev/null
+++ b/Firmware/MotorControl/hall_velocity_compensator.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+// Experimental mrbobus loop shaping, fw-v0.5.6 only.
+// F(s)=(1.2*s^2+46.6*s+550)/(s^2+115*s+550).
+// Parallel first-order realization avoids ill-conditioned biquad DC sums.
+// This changes velocity feedback ONLY, never phase or safety measurements.
+class HallVelocityCompensator {
+public:
+    void reset() { initialized_ = false; }
+    float update(float input, float dt) {
+        if (!initialized_) {
+            slow_ = fast_ = previous_ = input;
+            initialized_ = true;
+        }
+        const float slow_b = (5.0f * dt) / (2.0f + 5.0f * dt);
+        const float fast_b = (110.0f * dt) / (2.0f + 110.0f * dt);
+        slow_ += slow_b * (input + previous_ - 2.0f * slow_);
+        fast_ += fast_b * (input + previous_ - 2.0f * fast_);
+        previous_ = input;
+        // 1.2 + (347/525)*LP5 - (452/525)*LP110; DC gain exactly one.
+        return input + 0.660952381f * (slow_ - input)
+                     - 0.860952381f * (fast_ - input);
+    }
+private:
+    bool initialized_ = false;
+    float slow_ = 0.0f, fast_ = 0.0f, previous_ = 0.0f;
+};
