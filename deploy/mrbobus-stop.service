[Unit]
Description=Mrbobus independent latched stop button
StartLimitIntervalSec=0
[Service]
User=taras
SupplementaryGroups=dialout
RuntimeDirectory=mrbobus-stop
ExecStart=/usr/bin/python3 /home/taras/robot/mrbobus_ws/tools/stop_panel.py --page /home/taras/robot/mrbobus_ws/src/mrbobus_bringup/web/stop.html --radio-port /dev/ttyAMA4
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/mrbobus-stop
[Install]
WantedBy=multi-user.target
