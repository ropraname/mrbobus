[Unit]
Description=Mrbobus independent latched stop button
Wants=network-online.target
After=network-online.target
[Service]
User=taras
RuntimeDirectory=mrbobus-stop
ExecStart=/usr/bin/python3 /home/taras/robot/mrbobus_ws/tools/stop_panel.py --page /home/taras/robot/mrbobus_ws/src/mrbobus_bringup/web/stop.html
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/mrbobus-stop
[Install]
WantedBy=multi-user.target
